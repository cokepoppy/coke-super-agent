-        vc.add_cmdline("highres=off".to_string());
-        vc.add_cmdline("clocksource=kvm-clock".to_string());
+        // These guest clock defaults are for the x86_64 KVM path. ARM64 uses
+        // the architected timer; kvm-clock is unavailable there, and disabling
+        // high-resolution timers leaves Chrome on a 4 ms tick.
+        #[cfg(target_arch = "x86_64")]
+        {
+            vc.add_cmdline("highres=off".to_string());
+            vc.add_cmdline("clocksource=kvm-clock".to_string());
+        }
         vc.add_cmdline("agent.unified_cgroup_hierarchy=true".to_string());
@@ -2411,9 +2411,12 @@
-        let mut set_expect: HashSet<String> = vec![
-            "highres=off",
-            "clocksource=kvm-clock",
-            "agent.unified_cgroup_hierarchy=true",
-        ]
+        let mut set_expect: HashSet<String> = vec!["agent.unified_cgroup_hierarchy=true"]
         .into_iter()
         .map(|s| s.to_string())
         .collect();
+        if cfg!(target_arch = "x86_64") {
+            set_expect.insert("highres=off".to_string());
+            set_expect.insert("clocksource=kvm-clock".to_string());
+        } else {
+            assert!(!vm_config.cmdlines.contains(&"highres=off".to_string()));
+            assert!(!vm_config.cmdlines.contains(&"clocksource=kvm-clock".to_string()));
+        }
         let set_unexpect: HashSet<String> = vec!["clocksource=tsc", "tsc=reliable"]

