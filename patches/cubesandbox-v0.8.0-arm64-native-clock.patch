+
+#[cfg(test)]
+mod clock_parameter_tests {
+    use super::*;
+
+    #[test]
+    fn clock_parameters_are_arch_specific() {
+        for tap in [true, false] {
+            let mut config = VmConfig::default();
+            add_snapshot_clock_parameters(&mut config, tap);
+            let has_param = |param: &str| config.cmdlines.contains(&param.to_string());
+
+            if cfg!(target_arch = "x86_64") {
+                assert_eq!(has_param("highres=off"), tap);
+                assert_eq!(has_param("clocksource=kvm-clock"), tap);
+                assert_eq!(has_param("clocksource=tsc"), !tap);
+                assert_eq!(has_param("tsc=reliable"), !tap);
+            } else {
+                assert!(!has_param("highres=off"));
+                assert!(!has_param("clocksource=kvm-clock"));
+                assert!(!has_param("clocksource=tsc"));
+                assert!(!has_param("tsc=reliable"));
+            }
+        }
+    }
+}
