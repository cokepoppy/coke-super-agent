{
  "name": "coke-super-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/index.ts",
    "start:web": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "start:web:public": "vite preview --host 127.0.0.1 --port 5174 --strictPort",
    "start:local": "concurrently -k \"npm:start\" \"npm:start:web\"",
    "macos:install-public-services": "bash scripts/macos/install-public-services.sh",
    "db:migrate": "tsx src/server/migrate.ts",
    "db:seed": "tsx src/server/seed.ts",
    "docker:desktop-image": "bash scripts/docker/build-csa-docker-desktop-image.sh",
    "cube:desktop-image": "tsx scripts/cube/build-desktop-image.ts",
    "cube:desktop-template": "tsx scripts/cube/create-desktop-template.ts",
    "test": "tsx --test src/server/*.test.ts",
    "test:public-routing": "node --test tests/public-routing.test.mjs",
    "test:dsh-runtime": "node --test scripts/cube/dsh-runtime/*.test.mjs"
  },
  "dependencies": {
    "@cubesandbox/sdk": "0.8.0",
    "dotenv": "^16.6.1",
    "mysql2": "^3.15.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "undici": "^6.19.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
