NODE_ENV=development
CSA_HOST=127.0.0.1
CSA_PORT=8080
# Build the UI for the public Nginx prefix, for example /super-agent/.
CSA_PUBLIC_BASE_PATH=/super-agent/
CSA_COOKIE_SECURE=false
CSA_TOKEN_ENCRYPTION_KEY=generate-a-32-byte-base64url-key

# Point these at a dedicated Coke Super Agent schema. Never point development
# at a shared application's database credentials or data volume.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_USER=csa_dev
MYSQL_PASSWORD=replace-with-a-local-secret
MYSQL_DATABASE=coke_super_agent

# Local-only bootstrap accounts. Replace both passwords before any network exposure.
CSA_TEST_PASSWORD_ALPHA=alpha-local-change-me
CSA_TEST_PASSWORD_BETA=beta-local-change-me

# Local CubeSandbox control and data plane. Open these only through the
# loopback SSH tunnel created by scripts/cube/ensure-local-api-tunnel.sh.
CUBE_API_URL=http://127.0.0.1:13000
CUBE_API_KEY=
CUBE_TEMPLATE_ID=
# Legacy snapshot override. Leave empty when using the preinstalled OCI template.
CSA_CUBE_DSH_TEMPLATE_SNAPSHOT_ID=
# Build tags stay local to Docker. Image publication goes only to the Mac
# loopback registry; `ensure-local-api-tunnel.sh` exposes it to Cube over SSH.
CSA_DESKTOP_IMAGE=coke-super-agent-desktop:dev
CSA_DESKTOP_IMAGE_PUSH=0
CSA_LOCAL_REGISTRY_DOCKER_HOST=localhost:15001
CSA_LOCAL_REGISTRY_GUEST_URL=http://127.0.0.1:15002
CSA_LOCAL_REGISTRY_REPOSITORY=coke-super-agent-desktop
CUBE_DESKTOP_BASE_IMAGE=
CUBE_PROXY_NODE_IP=127.0.0.1
CUBE_PROXY_PORT_HTTP=28080
CUBE_PROXY_SCHEME=http
# New tenant VMs require the XFS-backed workspace bind mount and node helper.
# Prepare them from the Mac with scripts/cube/install-tenant-workspace-storage.sh.
CSA_CUBE_WORKSPACE_MODE=lima
# Set only when Lima is installed somewhere other than the local lab default.
CSA_LIMACTL=

# Runtime dependencies are prepared through this Mac HTTP proxy, then baked
# into the Linux ARM64 OCI image by `npm run cube:desktop-image`.
CSA_NPM_HTTP_PROXY=http://127.0.0.1:7890

# Optional Ubuntu mirror used during the OCI image build on this Mac.
CSA_DESKTOP_APT_MIRROR=
CSA_DESKTOP_RESOLUTION=1280x800

# The DeepSeek Harness runs inside each tenant microVM. Use a model already
# enabled for this API account; the application does not purchase or switch it.
CSA_AGENT_RUNTIME=dsh
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# Pi uses the OpenAI-compatible endpoint; if unset, /anthropic is stripped from DEEPSEEK_BASE_URL.
CSA_PI_DEEPSEEK_BASE_URL=https://api.deepseek.com
DSH_MODEL=
